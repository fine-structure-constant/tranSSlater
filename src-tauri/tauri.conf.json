{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tranSSlater",
  "version": "0.1.0",
  "identifier": "com.tauri-app.translater",
  "build": {
    "beforeDevCommand": "node node_modules/vite/bin/vite.js",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "node scripts/frontend-build.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "tranSSlater",
        "width": 1020,
        "height": 760,
        "minWidth": 720,
        "minHeight": 480,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
